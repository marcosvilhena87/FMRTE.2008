<Window x:Class="FMRTE2008.Desktop.OfflineRosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F27 — Elenco e clubes fictícios (offline)" Width="1060" Height="760"
        MinWidth="850" MinHeight="640">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="F27 — Navegação demonstrativa por jogadores e clubes"/>
      <TextBlock Text="DADOS INTEIRAMENTE FICTÍCIOS — SEM PROCESSO, SAVE, MAPAS OU EDIÇÃO"
                 TextWrapping="Wrap" Foreground="DarkRed" FontWeight="Bold" Margin="0,6,0,0"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Pesquisar" Click="Search_Click" Padding="14,6" Margin="8,0,0,0"/>
      <TextBox x:Name="QueryBox" MaxLength="120" VerticalContentAlignment="Center" MinHeight="32"/>
    </DockPanel>
    <DataGrid Grid.Row="2" x:Name="RosterGrid" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionChanged="RosterGrid_SelectionChanged" CanUserAddRows="False" CanUserDeleteRows="False"
              Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID fictício" Binding="{Binding Profile.DemonstrationId}" Width="*"/>
        <DataGridTextColumn Header="Jogador" Binding="{Binding Profile.DisplayName}" Width="2*"/>
        <DataGridTextColumn Header="Posição" Binding="{Binding Profile.Position}" Width="*"/>
        <DataGridTextColumn Header="Clube fictício" Binding="{Binding Club.Name}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,0,0,12">
      <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Próximo jogador" Click="Next_Click"
              Padding="12,6" Margin="8,0,0,0"/>
      <Button x:Name="PreviousButton" DockPanel.Dock="Right" Content="Jogador anterior" Click="Previous_Click"
              Padding="12,6"/>
      <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
    <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Header="Técnicos" Grid.Column="0" Margin="0,0,6,8">
        <DataGrid x:Name="TechnicalGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="65"/></DataGrid.Columns>
        </DataGrid>
      </GroupBox>
      <GroupBox Header="Mentais" Grid.Column="1" Margin="6,0,6,8">
        <DataGrid x:Name="MentalGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="65"/></DataGrid.Columns>
        </DataGrid>
      </GroupBox>
      <GroupBox Header="Físicos" Grid.Column="2" Margin="6,0,0,8">
        <DataGrid x:Name="PhysicalGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
          <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="65"/></DataGrid.Columns>
        </DataGrid>
      </GroupBox>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
        <TextBlock x:Name="ClubText" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ContractText" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="DarkRed" Margin="0,6,0,0"
                   Text="Somente leitura. Nenhum dado é transferido ao Football Manager."/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>