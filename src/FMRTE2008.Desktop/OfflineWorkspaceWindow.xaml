<Window x:Class="FMRTE2008.Desktop.OfflineWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F28 — Espaço integrado fictício (offline)"
        Width="1140" Height="790" MinWidth="900" MinHeight="650">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="F28 — Jogadores e clubes • espaço integrado" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="EXCLUSIVAMENTE FICTÍCIO — OFFLINE — SEM PROCESSO, SAVE, MAPA OU EDIÇÃO"
                 Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <Button x:Name="ResetButton" DockPanel.Dock="Right" Click="Reset_Click"
              Content="Mostrar todos" Padding="10,6" Margin="8,0,0,0"/>
      <Button x:Name="SearchButton" DockPanel.Dock="Right" Click="Search_Click"
              Content="Pesquisar" Padding="10,6" Margin="8,0,0,0"/>
      <TextBox x:Name="QueryBox" MaxLength="120" MinHeight="32"
               VerticalContentAlignment="Center"/>
    </DockPanel>
    <DataGrid Grid.Row="2" x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Single" SelectionChanged="PlayersGrid_SelectionChanged"
              Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID demonstrativo" Binding="{Binding Profile.DemonstrationId}" Width="*"/>
        <DataGridTextColumn Header="Jogador" Binding="{Binding Profile.DisplayName}" Width="2*"/>
        <DataGridTextColumn Header="Posição" Binding="{Binding Profile.Position}" Width="*"/>
        <DataGridTextColumn Header="Clube fictício" Binding="{Binding Club.Name}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,0,0,10">
      <Button x:Name="NextButton" DockPanel.Dock="Right" Click="Next_Click" Content="Próximo"
              Padding="12,6" Margin="8,0,0,0"/>
      <Button x:Name="PreviousButton" DockPanel.Dock="Right" Click="Previous_Click" Content="Anterior"
              Padding="12,6"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
    </DockPanel>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="Perfil, clube e contrato" Margin="0,0,8,0">
        <StackPanel Margin="12">
          <TextBlock x:Name="PlayerText" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"
                     Margin="0,0,0,9"/>
          <TextBlock x:Name="ClubText" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <TextBlock x:Name="CityCountryText" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <TextBlock x:Name="ContractText" TextWrapping="Wrap" Margin="0,0,0,7"/>
          <TextBlock x:Name="WageText" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button x:Name="ClubButton" Content="Ver jogadores deste clube fictício"
                  Click="Club_Click" Padding="10,6" Margin="0,0,0,8"/>
          <TextBlock x:Name="ClubMembersText" TextWrapping="Wrap"/>
        </StackPanel>
      </GroupBox>
      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Header="Técnicos" Margin="0,0,5,0">
          <DataGrid x:Name="TechnicalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="60"/></DataGrid.Columns>
          </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="Mentais" Margin="5,0,5,0">
          <DataGrid x:Name="MentalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="60"/></DataGrid.Columns>
          </DataGrid>
        </GroupBox>
        <GroupBox Grid.Column="2" Header="Físicos" Margin="5,0,0,0">
          <DataGrid x:Name="PhysicalGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns><DataGridTextColumn Header="Atributo" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="1–20" Binding="{Binding Value}" Width="60"/></DataGrid.Columns>
          </DataGrid>
        </GroupBox>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="5" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="DarkRed"
               Text="Somente dados inventados em memória local. Nenhuma conexão ao FM2008 ou transferência para jogos ou saves."/>
  </Grid>
</Window>